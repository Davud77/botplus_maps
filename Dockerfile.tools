FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PROJ_NETWORK=OFF
RUN apt-get update && apt-get install -y --no-install-recommends gdal-bin libgdal-dev build-essential \
    && python -m pip install --no-cache-dir "GDAL==$(gdal-config --version)" \
    && apt-get purge -y --auto-remove build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY server/geo /app/server/geo
COPY server/cli.py /app/server/cli.py
COPY server/import_client.py /app/server/import_client.py
RUN groupadd --gid 10001 botplustools \
    && useradd --uid 10001 --gid 10001 --create-home botplustools
USER 10001:10001
ENTRYPOINT ["python", "-m", "server.cli"]
